{:paths ["src" "resources"]
 
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner 
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.9.6"
                                                :git/sha "8e78bcc"}}
          :ns-default build}
  :dev {:extra-deps {djblue/portal {:mvn/version "0.56.0"}
                     io.github.nextjournal/clerk {:mvn/version "0.16.1016"}}}}

 :jvm-opts ["-XX:+UseZGC" "-XX:+ZGenerational" "-XX:MaxRAMPercentage=75"]
 
 :deps
 {org.clojure/clojure {:mvn/version "1.11.3"}
  io.github.nextjournal/clerk {:mvn/version "0.16.1016"}
  hato/hato {:mvn/version "0.9.0"}
  io.github.clingen-data-model/genegraph-framework  {:git/tag "0.1-alpha.32"
                                                     :git/sha "124e079"}
  }
 }
